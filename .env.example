# Copier ce fichier en .env et remplir les valeurs.
# En production, renseigner ces variables dans le tableau de bord de l'hébergeur.

# Serveur
NODE_ENV=development
PORT=4000
# URL(s) du frontend autorisée(s) par CORS, séparées par des virgules
# ex. production : https://notedefrais.vercel.app
CORS_ORIGIN=http://localhost:5173

# Base de données (local, ou URL MongoDB Atlas : mongodb+srv://...)
MONGO_URI=mongodb://localhost:27017/ndf

# Authentification
# Générer une valeur avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_long_random_string

# Scan IA des justificatifs (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Stockage des justificatifs : "local" (dossier uploads/) ou "s3"
# En production, utiliser "s3" (Cloudflare R2, AWS S3...) : le disque des
# hébergeurs est effacé à chaque redéploiement.
STORAGE_DRIVER=local
# Cloudflare R2 : S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com et S3_REGION=auto
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Envoi des notes par email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your_smtp_password
# Expéditeur (optionnel, SMTP_USER par défaut)
MAIL_FROM="Note de frais <user@example.com>"
